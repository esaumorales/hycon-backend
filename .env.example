# Copia este archivo como .env y completa los valores.

# ---- Base de datos ----
DATABASE_URL="postgresql://hycon_user:hycon_password@localhost:5432/hycon_db?schema=public"

# ---- Servidor ----
PORT=4000
NODE_ENV=development
# Direccion publica del backend; con ella se arman las URLs de las imagenes locales
PUBLIC_URL=http://localhost:4000
# Origenes permitidos para CORS, separados por coma. Van las direcciones exactas
# del frontend, incluido el protocolo. Las vistas previas de Vercel cambian de
# direccion en cada despliegue: si las necesitas, agregalas aqui tambien.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://hycon-sigma.vercel.app

# ---- Cookie de sesion ----
# Con el frontend y la API en dominios distintos, la cookie necesita estas dos.
# Exigen HTTPS en la API: el navegador descarta una cookie SameSite=None sin Secure.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ---- Documentacion de la API ----
# La referencia Scalar solo se publica fuera de produccion: en un servidor real
# seria el mapa de todo lo que acepta el servidor. Ponlo en true para abrirla
# a proposito en un despliegue concreto.
API_DOCS=

# ---- Seguridad ----
# Minimo 32 caracteres; en produccion el servidor no arranca sin esto
JWT_SECRET=

# ---- Cloudinary ----
# Aloja las imagenes del catalogo, las publicaciones y los avatares.
# El navegador sube directo con una firma que da el backend, asi el secreto
# nunca sale del servidor. Si se dejan vacias, las imagenes se guardan en disco.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta donde se agrupan las imagenes dentro de Cloudinary
CLOUDINARY_CARPETA=hycon

# ---- Video de los cursos ----
# Donde se guardan los videos nuevos de las lecciones:
#   youtube -> solo se pega el enlace (gratis, publico en youtube.com)
#   r2      -> Cloudflare R2: se paga el almacenamiento y el trafico es gratis
#   stream  -> Cloudflare Stream: convierte a varias calidades y cobra por minuto
# Cambiar esta linea no toca los videos que ya estan: cada leccion recuerda de
# donde sale el suyo, asi que los tres conviven sin migrar nada.
VIDEO_PROVEEDOR=youtube
# Minutos que vive el enlace firmado de un video
VIDEO_FIRMA_MINUTOS=120
# Peso maximo de un video subido desde el panel
VIDEO_MAXIMO_MB=1024
# Duracion maxima por video (la exige Cloudflare Stream al crear la subida)
VIDEO_MAXIMO_MINUTOS=240

# ---- Cloudflare R2 (VIDEO_PROVEEDOR=r2) ----
# El bucket necesita una regla de CORS que permita PUT y GET desde el dominio
# del frontend; sin eso el navegador no puede subir el archivo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Carpeta donde se agrupan los videos dentro del bucket
R2_CARPETA=cursos

# ---- Cloudflare Stream (VIDEO_PROVEEDOR=stream) ----
# El token necesita permiso de Stream: Edit. El dominio es el que da Cloudflare
# para el reproductor, con la forma customer-xxxxxxxx.cloudflarestream.com
STREAM_ACCOUNT_ID=
STREAM_API_TOKEN=
STREAM_DOMINIO=
